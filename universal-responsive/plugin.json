{
    "$schema": "../../../system/schema/template.json",
    "name": "Univerzální responzivní motiv",
    "description": "Univerzální responzivní motiv se světlým a tmavým režimem",
    "version": "1.0.2",
    "environment": {
        "system": "^8.3.1"
    },
    "responsive": true,
    "js": ["template.js"],
    "layouts": {
        "default": {
            "template": "template.php",
            "slots": ["right"]
        }
    },
    "config_defaults": {
        "logo_url": "",
        "logo_alt": "",
        "header_text": ""
    },
    "events": [
        {"event": "tpl.start", "script": "event/config.php"}
    ],
    "box.item": "section",
    "box.title": "h2",
    "box.title.inside": true
}
